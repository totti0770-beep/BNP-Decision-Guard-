# ---- Build stage ----
FROM node:22-alpine AS build
WORKDIR /repo
COPY package.json package-lock.json* ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
RUN npm install --workspace @bnp/shared --workspace @bnp/api --include-workspace-root
COPY packages/shared packages/shared
COPY apps/api apps/api
RUN npm run build -w @bnp/shared && npm run build -w @bnp/api

# ---- Runtime stage ----
FROM node:22-alpine AS runtime
WORKDIR /repo
ENV NODE_ENV=production
COPY --from=build /repo/package.json ./
COPY --from=build /repo/node_modules ./node_modules
COPY --from=build /repo/packages/shared/package.json ./packages/shared/
COPY --from=build /repo/packages/shared/dist ./packages/shared/dist
COPY --from=build /repo/apps/api/package.json ./apps/api/
COPY --from=build /repo/apps/api/dist ./apps/api/dist
WORKDIR /repo/apps/api
EXPOSE 4000
# Runs migrations, optionally provisions an administrator, optionally seeds
# demo data (SEED_ON_BOOT=true), then starts the API.
#
# The create-admin step is the only execution vector into a managed container
# with no shell access: when ADMIN_EMAIL and ADMIN_PASSWORD are both set it
# provisions (or repairs) a SUPER_ADMIN before the app boots — deliberately
# BEFORE main.js, so on the same boot where DemoAccountGuardService disables
# demo accounts the administrator already exists and there is no lockout
# window. The script is idempotent (same password + active + SUPER_ADMIN =
# no-op), refuses weak or published passwords, and never prints the password.
# Remove the two variables once the administrator is confirmed working:
# while they are set, a password rotated in-app is reset back at next boot.
#
# Its failure is FATAL, and that is a correction of a real incident rather
# than caution. It previously warned and carried on — but "carrying on" means
# booting the app, and the app's boot sweep then disables every account still
# using a published password. On 2026-08-22 an ADMIN_PASSWORD of 9 characters
# was rejected by the password policy, so the administrator was never created,
# and the sweep proceeded to disable all seven demo accounts: zero active
# users on a live clinical system, from a typo in a variable.
#
# Exiting non-zero instead makes Railway (or any orchestrator) keep the
# previous deployment serving while the operator fixes the variable. That
# leaves the published demo credentials live for a few more minutes — an
# exposure that was already ongoing — rather than trading it for a total
# outage. Provisioning and sweeping must succeed or fail together; doing one
# without the other is the only combination that locks everybody out.
#
# The seed gate consults NODE_ENV, not just SEED_ON_BOOT. This image sets
# NODE_ENV=production (above), and the demo accounts the seed creates use
# passwords published in README.md — so a flag left true on a production
# deployment used to be enough to put seven known-credential accounts,
# including SUPER_ADMIN, into a live clinical database. SEED_ALLOW_PRODUCTION
# is the deliberate override for a throwaway demo. `seed.js` enforces the same
# rule itself, so running it by hand is gated too.
#
# A failed seed stays non-fatal on purpose — a transient seeding problem must
# not keep the clinical API down — but it is no longer silent. It previously
# ended in a bare `|| true`, so a stack with zero users looked completely
# healthy: the API served 401s to every login and nothing said why.
CMD ["sh", "-c", "node dist/scripts/migrate.js && if [ -n \"$ADMIN_EMAIL\" ] && [ -n \"$ADMIN_PASSWORD\" ]; then node dist/scripts/create-admin.js || { echo '!!!!!! CREATE-ADMIN FAILED — refusing to start. See the error above. The previous deployment keeps serving; fix ADMIN_PASSWORD and redeploy. !!!!!!'; exit 1; }; fi && if [ \"$SEED_ON_BOOT\" = \"true\" ]; then if [ \"$NODE_ENV\" != \"production\" ] || [ \"$SEED_ALLOW_PRODUCTION\" = \"true\" ]; then node dist/seed/seed.js || echo '!!!!!! SEED FAILED — the API is starting WITHOUT demo data and logins will fail; see the error above !!!!!!'; else echo '>>> SEED_ON_BOOT=true ignored because NODE_ENV=production. The demo accounts use passwords published in README.md. Provision a real administrator with: ADMIN_EMAIL=... ADMIN_PASSWORD=... node dist/scripts/create-admin.js  (or set SEED_ALLOW_PRODUCTION=true if this deployment holds no real data).'; fi; fi && node dist/main.js"]
