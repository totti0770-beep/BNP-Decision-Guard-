# ---- Database ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bnp
POSTGRES_PASSWORD=bnp_secret
POSTGRES_DB=bnp_decision_guard

# ---- API ----
# NODE_ENV=production makes the API fail-fast if any secret below is missing
# or left at its shipped default (JWT secrets, POSTGRES_PASSWORD, S3_SECRET_KEY).
NODE_ENV=development
API_PORT=4000
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-too-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ---- Security ----
# Comma-separated allowlist of browser origins permitted to call the API.
# In production this MUST be set explicitly; empty blocks all cross-origin calls.
CORS_ORIGINS=http://localhost:3000
# Per-IP rate limits (window seconds / max requests / stricter max on /auth/*)
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
# Max JSON request body size (uploads use multipart and are capped separately)
REQUEST_BODY_LIMIT=25mb
# Per-account brute-force lockout: lock after N consecutive failed logins,
# for this many minutes (complements the per-IP rate limit above)
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# Password reset token lifetime (minutes)
PASSWORD_RESET_TOKEN_MINUTES=30

# ---- Email (password-reset delivery) ----
# console = log the message instead of sending (local development only)
# smtp    = deliver via the SMTP relay configured below
# none    = self-service reset is deliberately disabled; admins rotate
#           passwords from the Users screen instead
# In production this MUST be set explicitly to "smtp" or "none": an unset
# value, or "console" (which writes a working reset link into the server log),
# refuses to boot. A reset nobody receives is indistinguishable from one that
# failed, so the choice has to be deliberate.
MAIL_PROVIDER=console
MAIL_FROM=BNP Decision Guard <no-reply@bnp.health>
# Public origin of the web app — used to build the reset link in the email.
APP_WEB_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=587
# true for implicit TLS on port 465; false lets port 587 negotiate STARTTLS.
SMTP_SECURE=false
# Leave blank for an unauthenticated internal relay.
SMTP_USER=
SMTP_PASSWORD=

# Local-demo escape hatch: return the reset token in the API response so the
# flow can be completed without email. Never enable outside local development;
# it is refused in production regardless.
AUTH_DEV_RETURN_RESET_TOKEN=false

# ---- MinIO / S3 ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=bnp_minio
S3_SECRET_KEY=bnp_minio_secret
S3_BUCKET=bnp-documents
S3_FORCE_PATH_STYLE=true

# ---- AI / RAG ----
# Providers: mock (no API key needed) | openai
# IMPORTANT: after changing EMBEDDING_PROVIDER, run POST /rag/reindex (as a
# knowledge manager) — chunks embedded by the previous provider are excluded
# from retrieval, so the assistant refuses everything until the corpus is
# re-embedded with the active provider.
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Must match the pgvector column dimension — vector(384) in the schema.
# text-embedding-3-small supports native 384-dim output via the API.
EMBEDDING_DIM=384
# Timeout per OpenAI-compatible request (one retry on 429/5xx/timeout)
OPENAI_TIMEOUT_MS=30000
RAG_TOP_K=8
RAG_FINAL_K=4
RAG_MIN_SIMILARITY=0.25

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:4000
