# ---- Database ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bnp
POSTGRES_PASSWORD=bnp_secret
POSTGRES_DB=bnp_decision_guard

# ---- API ----
API_PORT=4000
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-too-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ---- MinIO / S3 ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=bnp_minio
S3_SECRET_KEY=bnp_minio_secret
S3_BUCKET=bnp-documents
S3_FORCE_PATH_STYLE=true

# ---- AI / RAG ----
# Providers: mock (no API key needed) | openai
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384
RAG_TOP_K=8
RAG_FINAL_K=4
RAG_MIN_SIMILARITY=0.25

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:4000
